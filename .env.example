# ==============================================================================
# PricePilot AI - Environment Configuration Example
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Client-side, prefixed with VITE_)
# Place in root .env or .env.local
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api
VITE_PRODUCT_PROVIDER=external

# Firebase Client SDK Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Server-side)
# Place in server/.env or server/.env.local
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database & Storage
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pricepilot?retryWrites=true&w=majority
STORAGE_PROVIDER=local # 'local' or 's3'
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_s3_bucket_name
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret

# Firebase Admin SDK (Server Authentication)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Security & Background Job Protection
# Required for triggering POST /api/cron/check-prices
CRON_SECRET=super_secret_cron_token_min_16_chars

# Development-only authentication bypass (Set to 'false' in production!)
ALLOW_DEV_AUTH_BYPASS=false

# ------------------------------------------------------------------------------
# 3. EXTERNAL DATA PROVIDERS (All optional with graceful degradation & mock fallback)
# ------------------------------------------------------------------------------

# Product Discovery (SerpApi, Serper, SearchApi, DataForSEO)
PRODUCT_SEARCH_API_KEY=your_serpapi_key
SERPAPI_KEY=your_serpapi_key
SERPER_KEY=your_serper_key
SEARCHAPI_KEY=your_searchapi_key
DATAFORSEO_LOGIN=your_dataforseo_login
DATAFORSEO_PASSWORD=your_dataforseo_password

# Keepa API (Amazon 90-day price history backfill)
KEEPA_KEY=your_keepa_api_key

# Icecat Specs API (Open catalog product specification normalization)
ICECAT_API_KEY=your_icecat_api_key
ICECAT_USERNAME=your_icecat_username

# Affiliate Monetization (Cuelinks outbound merchant link redirection)
CUELINKS_PUB_ID=your_cuelinks_publisher_id
CUELINKS_API_KEY=your_cuelinks_api_key

# AI Intelligence & Document Parsing
GEMINI_API_KEY=your_gemini_api_key # Used for Conversational Agent & Vision receipt scanner

# Multi-Channel Alert Notification Providers
RESEND_API_KEY=re_your_resend_api_key # Email price drop alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token # Telegram bot dispatch
TELEGRAM_CHAT_ID=your_telegram_channel_or_chat_id # Default chat ID
FCM_SERVER_KEY=your_fcm_legacy_server_key # Mobile Web Push

# Distributed Caching (Optional; defaults to MongoDB/In-Memory if empty)
REDIS_URL=redis://localhost:6379

# Mock Mode (Set to 'true' for offline automated testing without API costs)
USE_MOCK_DATA=false
PRICE_CHECK_INTERVAL=6
